---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroSlider from '../components/HeroSlider.astro';
import WorkCategoryGrid from '../components/WorkCategoryGrid.astro';
import EditorialHeader from '../components/EditorialHeader.astro';
import Img from '../components/Img.astro';
import { IMAGES, SERVICES, PROCESS_STEPS, HOME_TESTIMONIALS, PRESS_LOGOS } from '../data/content';
import { cld, srcset, WIDTHS } from '../data/cloudinary';
import { HERO_SLIDES } from '../data/content';

const title = 'DrewImages — creative direction and photography by Drew Bordeaux';
const description = 'Art direction and photography for album covers, press images and campaigns. Drew Bordeaux works with artists, labels and brands from New York and the Hudson Valley.';
---
<Base title={title} description={description} ogImageAlt="Portrait of Cyrille Aimée by DrewImages">
  <link slot="head" rel="preload" as="image" imagesrcset={srcset(HERO_SLIDES[0].src, WIDTHS.hero)} imagesizes="100vw" fetchpriority="high" />
  <div class="flex flex-col w-full">
    <HeroSlider />

    <!-- Latest work: credit band -->
    <div class="bg-ink text-paper border-t border-paper/10 relative z-10">
      <Section class="py-8 md:py-10">
        <a href="/work/the-devil-i-knew" class="group flex flex-col md:flex-row md:items-center md:justify-between gap-3 md:gap-10">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-mustard shrink-0">Latest work</span>
          <span class="flex-grow">
            <span class="block font-serif text-2xl md:text-3xl leading-snug">Art direction and photography for Nicole Zuraitis’s album <span class="italic">The Devil I Knew</span></span>
            <span class="block mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-paper/50">For your consideration: Best Album Cover</span>
          </span>
          <span class="text-xs font-bold uppercase tracking-widest text-paper/60 group-hover:text-paper transition-colors shrink-0">See the work →</span>
        </a>
      </Section>
    </div>

    <!-- 01: Intro / capabilities -->
    <div class="bg-teal text-ink bg-grain relative z-10">
      <Section class="py-16 md:py-32">
        <EditorialHeader number="01" title="Studio Context" colorClass="border-ink/20" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 md:gap-16 items-start">
          <div class="lg:col-span-5 relative lg:sticky lg:top-24">
            <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl mb-6 md:mb-8 leading-[0.95] md:leading-[0.9] text-balance">
              Made for <br /> the <span class="italic text-paper">square.</span>
            </h2>
            <p class="text-base md:text-lg leading-relaxed text-ink/80 mb-8 md:mb-10 font-light max-w-md">
              Most of what I make ends up in a square: an album cover, a post, a twelve-inch sleeve. I’m a songwriter and record producer too, so I start from the music and build the pictures around it.
            </p>

            <div class="flex flex-col gap-4 border-l border-ink/20 pl-6">
              <div class="flex items-baseline gap-4">
                <span class="text-[10px] font-bold uppercase tracking-widest min-w-[70px] md:min-w-[80px] opacity-50">Direction</span>
                <span class="font-serif italic text-lg">Concept & References</span>
              </div>
              <div class="flex items-baseline gap-4">
                <span class="text-[10px] font-bold uppercase tracking-widest min-w-[70px] md:min-w-[80px] opacity-50">Capture</span>
                <span class="font-serif italic text-lg">Editorial Photography</span>
              </div>
              <div class="flex items-baseline gap-4">
                <span class="text-[10px] font-bold uppercase tracking-widest min-w-[70px] md:min-w-[80px] opacity-50">Delivery</span>
                <span class="font-serif italic text-lg">Campaign Assets</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-4 -mx-4 md:mx-0">
            <div class="space-y-4 pt-0 md:pt-24">
              <div class="aspect-[3/4] overflow-hidden bg-ink/5">
                <Img photo={IMAGES.homeConcept} sizes="(min-width: 1024px) 28vw, (min-width: 768px) 50vw, 100vw" class="w-full h-full object-cover contrast-110 hover:scale-105 transition-transform duration-700 ease-out" />
              </div>
              <div class="p-4 md:p-6 bg-mustard text-ink shadow-sm mx-4 md:mx-0">
                <span class="block font-serif italic text-xl md:text-2xl mb-1">Concept</span>
                <span class="text-[10px] uppercase tracking-widest font-bold opacity-70">From Moodboard to Final</span>
              </div>
            </div>
            <div class="space-y-4">
              <div class="bg-burgundy p-4 md:p-6 text-paper shadow-sm mx-4 md:mx-0 mt-4 md:mt-0">
                <span class="block font-serif italic text-xl md:text-2xl mb-1">Rollout</span>
                <span class="text-[10px] uppercase tracking-widest font-bold opacity-60 text-mustard">Campaign Assets</span>
              </div>
              <div class="aspect-[3/4] overflow-hidden bg-ink/5">
                <Img photo={IMAGES.homeRollout} sizes="(min-width: 1024px) 28vw, (min-width: 768px) 50vw, 100vw" class="w-full h-full object-cover contrast-110 hover:scale-105 transition-transform duration-700 ease-out" />
              </div>
            </div>
          </div>
        </div>
      </Section>
    </div>

    <!-- 02: Process & services -->
    <div class="bg-mustard text-ink bg-grain relative z-10">
      <Section class="py-16 md:py-32">
        <EditorialHeader number="02" title="Process & Services" colorClass="border-ink/20" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 md:gap-16 items-start mb-16 md:mb-24">
          <div class="lg:col-span-6">
            <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl leading-[0.95] md:leading-[0.9] mb-8 md:mb-10">
              How things <br /><span class="italic text-white">come together.</span>
            </h2>


            <div class="text-base md:text-lg leading-relaxed opacity-90 max-w-xl space-y-6 md:space-y-8 font-light">
              <p>
                I work with artists and their teams, and with a few companies, on a single release or across several.
              </p>
              <p>
                A release needs more than a cover: press images, lyric visuals, the posts that go out around it. I plan them together, so they look like one record.
              </p>
              <a href="/work/the-devil-i-knew" class="group block pt-6 border-l-2 border-ink/20 pl-6">
                <span class="block text-[10px] font-bold uppercase tracking-widest opacity-60 mb-2">Most recent</span>
                <span class="block font-serif italic text-xl md:text-2xl text-ink group-hover:text-white transition-colors">
                  The Devil I Knew, Nicole Zuraitis: art direction, cover, press images, lyric visuals and vinyl. &rarr;
                </span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 flex flex-col justify-center">
            <div class="bg-paper/10 p-6 md:p-12 border border-ink/10 backdrop-blur-sm">
              <ul class="space-y-0">
                {PROCESS_STEPS.map((step, i) => (
                  <li class="group border-b border-ink/10 py-4 md:py-5 first:pt-0 last:border-0 cursor-default" tabindex="0">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-4 md:gap-6">
                        <span class="text-xs font-sans font-bold opacity-30 w-6">0{i + 1}</span>
                        <span class="font-serif text-2xl md:text-3xl italic group-hover:text-white group-focus:text-white transition-colors duration-300">{step.title}</span>
                      </div>
                      <span class="text-xl opacity-30 group-hover:opacity-100 group-focus:opacity-100 transition-all duration-300 group-hover:rotate-45 group-focus:rotate-45 group-hover:text-white group-focus:text-white" aria-hidden="true">+</span>
                    </div>
                    <div class="overflow-hidden max-h-0 opacity-0 group-hover:max-h-24 group-hover:opacity-100 group-focus:max-h-24 group-focus:opacity-100 transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] pl-10 md:pl-12">
                      <p class="text-sm font-medium opacity-70 pt-3 max-w-sm">{step.desc}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-baseline gap-4 mb-6 md:mb-8">
            <h3 class="font-serif text-3xl md:text-4xl">Ways of Working</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 border-t border-ink/20">
            {SERVICES.map((service, i) => (
              <a href="/services" class={`group block p-6 md:p-12 border-b md:border-b-0 border-ink/20 hover:bg-paper transition-colors duration-500 ${i !== 2 ? 'md:border-r' : ''} border-b`}>
                <h3 class="font-serif text-2xl md:text-3xl mb-3 md:mb-4 group-hover:text-teal transition-colors relative z-10">{service.title}</h3>
                <p class="text-sm font-medium opacity-70 mb-6 md:mb-8 leading-relaxed relative z-10 min-h-[40px]">{service.description}</p>
                <div class="flex justify-end relative z-10">
                  <span class="opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity font-serif italic text-sm text-burgundy md:text-inherit">Inquire &rarr;</span>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-6 flex flex-col md:flex-row justify-between items-start md:items-center border-t border-ink/10 pt-6 text-[10px] font-bold uppercase tracking-widest opacity-50 gap-2">
            <p>Each project is quoted after a first call.</p>
            <a href="/services" class="hover:opacity-100 transition-opacity">How projects work &rarr;</a>
          </div>
        </div>
      </Section>
    </div>

    <!-- 03: Work -->
    <div class="bg-paper text-ink bg-grain relative z-10">
      <Section class="py-16 md:py-32">
        <EditorialHeader number="03" title="Selected Works" colorClass="border-ink/20" />

        <div class="flex flex-col md:flex-row justify-between items-end mb-8 md:mb-12">
          <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl text-burgundy">Work</h2>
          <a href="/work" class="text-[10px] md:text-xs font-bold uppercase tracking-widest border-b border-ink/30 pb-1 hover:text-burgundy hover:border-burgundy transition-colors mt-6 md:mt-0">View Full Archive</a>
        </div>

        <WorkCategoryGrid />
      </Section>
    </div>

    <!-- 04: Testimonials -->
    <div class="bg-burgundy text-paper bg-grain relative z-10">
      <Section class="py-16 md:py-32">
        <EditorialHeader number="04" title="Perspectives" colorClass="border-paper/20" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-24 gap-y-12 md:gap-y-20">
          {HOME_TESTIMONIALS.map((item) => (
            <figure class="flex flex-col sm:flex-row gap-6 md:gap-8 items-start">
              <div class="shrink-0 w-32 aspect-[3/2] md:w-48 border border-paper/20 p-1">
                <Img photo={item.photo} widths={WIDTHS.thumb} sizes="(min-width: 768px) 192px, 128px" class="w-full h-full object-cover contrast-125 opacity-90" />
              </div>
              <div class="flex flex-col h-full justify-between pt-1">
                <blockquote class="mb-4 md:mb-6">
                  <p class="font-serif text-lg md:text-2xl leading-relaxed opacity-95 mb-3">“{item.quote}”</p>
                  {item.secondary && <p class="text-sm md:text-base opacity-70 font-light leading-relaxed">{item.secondary}</p>}
                </blockquote>
                <figcaption class="flex items-center gap-3 mt-auto">
                  <span class="w-8 h-[1px] bg-paper/40"></span>
                  <span class="text-xs font-bold uppercase tracking-widest opacity-60">{item.author}</span>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>
      </Section>
    </div>

    <!-- Press -->
    <div class="bg-paper text-ink border-b border-ink/5 relative z-10">
      <Section class="py-16 md:py-24">
        <p class="text-center text-[10px] font-bold uppercase tracking-[0.3em] text-ink/30 mb-12 cursor-default selection:bg-ink/20">
          Selected editorial platforms
        </p>
        <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 mix-blend-multiply select-none pointer-events-none">
          {PRESS_LOGOS.map((logo) => (
            <img src={cld(logo.src, 400)} alt={logo.name} class="h-5 md:h-7 w-auto object-contain brightness-0" loading="lazy" decoding="async" />
          ))}
        </div>
      </Section>
    </div>

    <!-- Footer CTA -->
    <div class="bg-ink text-paper py-24 md:py-32 text-center relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-teal/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="relative z-10 max-w-2xl mx-auto px-6">
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-paper/40 mb-6 block">Inquiries</span>
        <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl mb-10 md:mb-12">Tell me what<br />you’re making.</h2>
        <Button href="/contact" variant="primary">Start a project</Button>
      </div>
    </div>
  </div>
</Base>
