---
// Contact: the inquiry form. Same Web3Forms request as the old site, plus project type, timing,
// links and budget, so the first reply can be useful. ?type=shoot|campaign|ongoing preselects the type.
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { IMAGES, CONTACT } from '../data/content';
import { WIDTHS } from '../data/cloudinary';

const title = 'Start a project — DrewImages';
const description = 'Start a release shoot, album campaign or ongoing creative direction with DrewImages. Tell Drew Bordeaux what you’re making, when it comes out and where the images will run.';
const field = 'w-full bg-transparent border-b-2 border-ink/20 focus:border-ink outline-none py-3 text-lg rounded-none transition-colors';
const label = 'block text-[10px] font-bold uppercase tracking-[0.2em] mb-2 text-ink/60';
---
<Base title={title} description={description} pageType="ContactPage">
  <section class="bg-paper bg-grain text-ink pt-32 md:pt-40 pb-20 md:pb-28 px-4 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16">
      <div class="lg:col-span-5 flex flex-col">
        <span class="block text-[10px] md:text-xs font-bold uppercase tracking-[0.25em] text-ink/50 mb-4">Inquiries</span>
        <h1 class="font-serif text-6xl md:text-8xl leading-[0.9] tracking-tight">Start a <span class="italic">project.</span></h1>
        <p class="mt-8 text-lg md:text-xl leading-relaxed text-ink/80 max-w-md">Tell me what you’re making, when it comes out, and where the images will run. I read every inquiry myself.</p>
        <p class="mt-6"><a href={`mailto:${CONTACT.email}`} class="text-base border-b border-ink/30 pb-1 hover:border-ink">{CONTACT.email}</a></p>
        <p class="mt-3 text-sm text-ink/60">How rights and AI work: <a href="/usage" class="underline underline-offset-4 hover:text-ink">Usage, rights &amp; AI</a></p>
        <div class="mt-12 hidden lg:block aspect-[4/3] overflow-hidden">
          <Img photo={IMAGES.contactHero} widths={WIDTHS.half} sizes="40vw" class="w-full h-full object-cover grayscale contrast-[1.1]" />
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div id="form-success" hidden class="[&[hidden]]:hidden flex flex-col justify-center p-10 md:p-14 bg-chocolate text-saffron">
          <h2 class="font-serif text-5xl leading-none mb-4">Received.</h2>
          <p class="text-paper/80 text-lg">Thanks for writing. I’ll be in touch.</p>
          <button type="button" id="form-reset" class="self-start text-xs uppercase underline mt-8 text-paper/60 hover:text-paper font-bold tracking-[0.2em]">Send another</button>
        </div>

        <form id="inquiry-form" class="space-y-9">
          <!-- Honeypot for bots: people never see or fill this -->
          <input id="website" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-9">
            <div>
              <label for="name" class={label}>Name</label>
              <input required type="text" id="name" name="name" autocomplete="name" class={field} />
            </div>
            <div>
              <label for="email" class={label}>Email</label>
              <input required type="email" id="email" name="email" autocomplete="email" class={field} />
            </div>
          </div>

          <div>
            <label for="project_type" class={label}>What’s it for?</label>
            <select id="project_type" name="project_type" class={`${field} appearance-none`}>
              <option value="">Choose one</option>
              <option value="shoot">A release shoot</option>
              <option value="campaign">An album campaign</option>
              <option value="ongoing">Ongoing creative direction</option>
              <option value="other">Something else</option>
            </select>
          </div>

          <div>
            <label for="timing" class={label}>When does it come out? <span class="normal-case tracking-normal font-normal">(a date or a season)</span></label>
            <input type="text" id="timing" name="timing" class={field} />
          </div>

          <div>
            <label for="details" class={label}>Tell me about it</label>
            <textarea required id="details" name="details" rows="4" class={`${field} resize-none`}></textarea>
          </div>

          <div>
            <label for="links" class={label}>Links <span class="normal-case tracking-normal font-normal">(optional: music, Instagram, a rough mix)</span></label>
            <input type="text" id="links" name="links" class={field} />
          </div>

          <div>
            <label for="budget" class={label}>Budget <span class="normal-case tracking-normal font-normal">(optional)</span></label>
            <select id="budget" name="budget" class={`${field} appearance-none`}>
              <option value="">Choose one</option>
              <option>$2,500–5,000</option>
              <option>$5,000–10,000</option>
              <option>$10,000–25,000</option>
              <option>$25,000+</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <p id="form-error" hidden class="text-sm text-red-700" role="alert"></p>

          <div class="pt-2">
            <button type="submit" id="form-submit" class="w-full sm:w-auto min-w-[220px] px-8 py-5 text-xs font-bold uppercase tracking-[0.2em] bg-ink text-paper hover:bg-burgundy disabled:opacity-60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ink">Send</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Same Web3Forms request the React site sent (JSON body, same key, subject and fields), plus the new questions.
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const success = document.getElementById('form-success')!;
  const errorEl = document.getElementById('form-error')!;
  const submit = document.getElementById('form-submit') as HTMLButtonElement;
  const label = submit.textContent;

  // Arriving from "Book a shoot" or "Start an album campaign" preselects the type
  const type = new URLSearchParams(location.search).get('type');
  const select = form.querySelector<HTMLSelectElement>('#project_type');
  if (type && select?.querySelector(`option[value="${CSS.escape(type)}"]`)) select.value = type;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const data = new FormData(form);
    if (data.get('website')) return; // bot protection

    submit.textContent = 'Sending…';
    submit.disabled = true;
    try {
      const payload = {
        access_key: '30b1f025-d07a-4132-ac6a-31fe88fe6b32',
        subject: 'New DrewImages Studio Inquiry',
        from_name: 'DrewImages Studio',
        name: data.get('name'),
        email: data.get('email'),
        message: data.get('details'),
        project_type: select?.value ? select.selectedOptions[0].textContent : 'Not given',
        timing: data.get('timing') || 'Not given',
        links: data.get('links') || 'None',
        budget: data.get('budget') || 'Not given',
      };
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (result.success) {
        form.reset();
        form.hidden = true;
        success.hidden = false;
        if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { form: 'inquiry' });
      } else {
        showError('Something went wrong. Please try again or email hello@drewbordeaux.com');
      }
    } catch {
      showError('Network error. Please try again.');
    } finally {
      submit.textContent = label;
      submit.disabled = false;
    }
  });

  document.getElementById('form-reset')!.addEventListener('click', () => {
    success.hidden = true;
    form.hidden = false;
  });
</script>
