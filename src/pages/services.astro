---
// Studio: the four ways to work, each with who it's for, what's in it and how it's priced; how a
// project goes; and the questions buyers ask first (marked up as FAQPage). This is the one page
// where the words do the work, so they stay plain and specific.
import Base from '../layouts/Base.astro';
import { OFFERS } from '../data/offers';
import { FAQ } from '../data/faq';
import { IMAGES } from '../data/content';
import { cld, srcset, ogImage } from '../data/cloudinary';

const title = 'Studio: creative direction, album campaigns, shoots and brand campaigns — DrewImages';
const description = 'How to work with Drew Bordeaux: creative direction and artist development, album campaigns, release shoots from $2,500, and campaigns for labels and brands. New York and the Hudson Valley.';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const PICTURES: Record<string, { src: string; alt: string; caption: string }> = {
  direction: { src: 'lauren-minear-autumn-white-dress-1', alt: 'Lauren Minear in a white dress, sitting in fallen leaves at dusk and looking away', caption: 'Lauren Minear' },
  campaign: { src: 'v1768634139/kimhawkeycollage_skzdts.png', alt: 'A spread of prints from the Kimberly Hawkey We the Nighthawks campaign, scattered on a wooden table', caption: 'Kimberly Hawkey, We the Nighthawks' },
  shoot: { src: 'v1768541914/A7409419__2_1_onzvjc.jpg', alt: 'Monifah smiling, a hand in her voluminous curls, wearing a fur collar', caption: 'Monifah' },
  brands: { src: 'v1768236231/isa_stitches_corkboard_s_bxgcqn.png', alt: 'Photos from the Isa Tailored & Made campaign pinned to a corkboard: models in white silk pieces beside dress forms', caption: 'Isa Tailored & Made' },
};

const STEPS = [
  ['Listen', 'You send the music, even a rough mix. We talk about what it is and where the pictures will run.'],
  ['Plan', 'I come back with a direction: references, looks, locations, the team and a budget.'],
  ['Shoot', 'One day or several. I direct and photograph, with a crew I work with all the time.'],
  ['Deliver', 'Retouched files, sized and named for every platform, with the usage in writing.'],
];
const W = [480, 800, 1200];
---
<Base title={title} description={description} ogImage={ogImage(IMAGES.serviceIdentity.src, 'face')} ogImageAlt={IMAGES.serviceIdentity.alt} schema={[faqSchema]}>
  <div class="bg-paper text-ink">
    <!-- Header -->
    <header class="px-4 md:px-8 pt-28 md:pt-40 pb-12 md:pb-20 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-end">
      <h1 class="lg:col-span-6 font-didone text-6xl md:text-8xl lg:text-9xl leading-[0.88] tracking-tight">Working together</h1>
      <div class="lg:col-span-6">
        <p class="font-text text-2xl md:text-[1.7rem] leading-snug max-w-xl">I direct and photograph releases for artists, and campaigns for the labels and brands around them. I write and produce records too, so every project starts with listening.</p>
        <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="On this page">
          {OFFERS.map((o) => <a href={`#${o.id}`} class="underline underline-offset-4 decoration-ink/40 hover:decoration-ink">{o.title}</a>)}
          <a href="#faq" class="underline underline-offset-4 decoration-ink/40 hover:decoration-ink">Questions</a>
        </nav>
      </div>
    </header>

    <!-- The four ways -->
    {OFFERS.map((o, n) => {
      const pic = PICTURES[o.id];
      const dark = o.id === 'brands';
      return (
        <section id={o.id} class={`scroll-mt-16 px-4 md:px-8 py-14 md:py-24 border-t ${dark ? 'bg-ink text-paper border-ink' : 'border-ink/15'}`}>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
            <figure class={`lg:col-span-5 ${n % 2 === 1 ? 'lg:order-2 lg:col-start-8' : ''}`}>
              <img src={cld(pic.src, 800)} srcset={srcset(pic.src, W)} sizes="(min-width: 1024px) 40vw, 100vw" alt={pic.alt} class={`w-full object-cover ${o.id === 'campaign' ? 'aspect-[4/3]' : 'aspect-[4/5]'}`} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption class={`mt-2 text-sm ${dark ? 'text-paper/60' : 'text-ink/60'}`}>{pic.caption}</figcaption>
            </figure>
            <div class={`lg:col-span-6 ${n % 2 === 1 ? 'lg:order-1' : 'lg:col-start-7'} lg:sticky lg:top-28`}>
              <p class={`font-didone italic text-4xl leading-none ${dark ? 'text-saffron' : 'text-burgundy'}`}>{o.numeral}</p>
              <h2 class="mt-3 font-didone text-5xl md:text-6xl lg:text-7xl leading-[0.95] tracking-tight">{o.title}</h2>
              <p class="mt-6 font-text text-xl md:text-2xl leading-snug">{o.forWhom}</p>
              <ul class={`mt-8 border-t ${dark ? 'border-paper/25' : 'border-ink/25'}`}>
                {o.includes.map((i) => <li class={`py-3 border-b text-base md:text-lg ${dark ? 'border-paper/15' : 'border-ink/15'}`}>{i}</li>)}
              </ul>
              <p class={`mt-6 text-sm ${dark ? 'text-paper/70' : 'text-ink/70'}`}>{o.price}.{o.id === 'campaign' || o.id === 'brands' ? <> Rights are written into every agreement: <a href="/usage" class="underline underline-offset-4">how usage works</a>.</> : null}</p>
              <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href={`/contact?type=${o.id}`} class={`inline-block text-sm font-semibold px-7 py-4 transition-colors ${dark ? 'bg-saffron text-chocolate hover:bg-paper' : 'bg-ink text-paper hover:bg-burgundy'}`}>{o.cta}</a>
                {o.href && <a href={o.href} class="text-sm underline underline-offset-4 decoration-current/40">How the sessions and the monthly work run</a>}
                {o.id === 'brands' && <a href="/work/isa-tailored-and-made" class="text-sm underline underline-offset-4 decoration-current/40">Isa Tailored & Made</a>}
                {o.id === 'brands' && <a href="/work/talea-ensemble" class="text-sm underline underline-offset-4 decoration-current/40">Talea Ensemble</a>}
                {(o.id === 'brands' || o.id === 'campaign') && <a href="/drewimages-studio.pdf" class="text-sm underline underline-offset-4 decoration-current/40">One page to forward (PDF)</a>}
              </p>
            </div>
          </div>
        </section>
      );
    })}

    <!-- How a project goes -->
    <section class="px-4 md:px-8 py-16 md:py-24 border-t border-ink/15" aria-labelledby="steps-title">
      <h2 id="steps-title" class="font-didone text-4xl md:text-6xl leading-none tracking-tight">How a project goes</h2>
      <ol class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 border-t-[3px] border-ink pt-8">
        {STEPS.map(([name, text], i) => (
          <li>
            <p class="font-didone italic text-3xl text-burgundy leading-none">{i + 1}</p>
            <h3 class="mt-3 font-didone text-3xl leading-none">{name}</h3>
            <p class="mt-3 font-text text-lg leading-relaxed text-ink/80">{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Why a musician -->
    <section class="bg-chocolate text-paper px-4 md:px-8 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <h2 class="lg:col-span-5 font-didone text-4xl md:text-6xl leading-[0.95] tracking-tight">I make records too.</h2>
        <div class="lg:col-span-6 lg:col-start-7 font-text text-xl md:text-2xl leading-relaxed text-paper/90 space-y-5">
          <p>I’m a songwriter and record producer, and a member of the Recording Academy. I know what a release costs an artist, and what the pictures have to do for it.</p>
          <p>So I listen first. The cover, the press images and the videos all come out of what the record is.</p>
          <p class="text-base"><a href="https://www.drewbordeaux.com/?utm_source=drewimages&utm_medium=referral&utm_campaign=studio" class="underline underline-offset-4 decoration-paper/40 hover:decoration-paper">My own records, at drewbordeaux.com</a></p>
        </div>
      </div>
    </section>

    <!-- Questions -->
    <section id="faq" class="px-4 md:px-8 py-16 md:py-24 scroll-mt-16" aria-labelledby="faq-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <h2 id="faq-title" class="lg:col-span-4 font-didone text-4xl md:text-6xl leading-none tracking-tight">Questions</h2>
        <div class="lg:col-span-8 border-t-[3px] border-ink">
          {FAQ.map((f) => (
            <details class="group border-b border-ink/15 py-5">
              <summary class="flex items-start justify-between gap-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <h3 class="font-didone text-2xl md:text-3xl leading-snug">{f.q}</h3>
                <span class="shrink-0 mt-1 text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-4 max-w-2xl font-text text-lg md:text-xl leading-relaxed text-ink/80">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- The ask -->
    <section class="bg-saffron text-chocolate px-4 md:px-8 py-20 md:py-28">
      <h2 class="font-didone text-5xl md:text-7xl lg:text-8xl leading-[0.92] tracking-tight max-w-4xl">Tell me what you’re making.</h2>
      <p class="mt-6 font-text text-xl max-w-xl">Shoots start at $2,500. Everything else is quoted after a first call.</p>
      <a href="/contact" class="inline-block mt-10 text-sm font-semibold px-8 py-5 bg-chocolate text-saffron hover:bg-ink transition-colors">Start a project</a>
    </section>
  </div>
</Base>
