---
// Services: the three ways to work, each with who it's for, what's included and a price line,
// then a plain-English FAQ (marked up as FAQPage so search engines and AI assistants can quote it).
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { OFFERS } from '../data/offers';
import { FAQ } from '../data/faq';
import { IMAGES } from '../data/content';
import { WIDTHS, ogImage } from '../data/cloudinary';
import devilCover from '../assets/work/the-devil-i-knew-cover.jpg';
import laurenCover from '../assets/work/lauren/til-the-world-ends-cover.jpg';

const title = 'Services: creative direction, album campaigns and release shoots — DrewImages';
const description = 'Creative direction and artist development for artists with a record underway, album campaigns for artists, labels and management, and release shoots from $2,500. By Drew Bordeaux, New York and the Hudson Valley.';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const offer = (id: string) => OFFERS.find((o) => o.id === id)!;
const direction = offer('direction');
const campaign = offer('campaign');
const shoot = offer('shoot');
const label = 'block text-[10px] md:text-xs font-bold uppercase tracking-[0.25em] mb-4';
---
<Base title={title} description={description} ogImage={ogImage(IMAGES.serviceIdentity.src, 'face')} ogImageAlt={IMAGES.serviceIdentity.alt} schema={[faqSchema]}>
  <!-- Header -->
  <section class="bg-paper bg-grain text-ink pt-32 md:pt-44 pb-16 md:pb-24 px-4 md:px-8">
    <span class={`${label} text-ink/50`}>Services</span>
    <h1 class="font-serif text-6xl md:text-8xl lg:text-9xl leading-[0.9] tracking-tight">Three ways <span class="italic">to work.</span></h1>
    <p class="mt-8 max-w-2xl text-lg md:text-xl leading-relaxed text-ink/80">
      I’m an art director and photographer, and I make records too. Most of my clients are musicians and the people around them: managers, labels and the occasional brand. On every project I direct the concept and the shoot, and bring in the team it needs.
    </p>
    <nav class="mt-10 flex flex-wrap gap-x-8 gap-y-3" aria-label="On this page">
      {OFFERS.map((o) => <a href={`#${o.id}`} class="text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 hover:text-burgundy">{o.numeral}. {o.title}</a>)}
      <a href="#faq" class="text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 hover:text-burgundy">FAQ</a>
    </nav>
  </section>

  <!-- I. Creative direction and artist development -->
  <section id={direction.id} class="bg-ink text-paper py-20 md:py-28 px-4 md:px-8 scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="aspect-[2/3] overflow-hidden bg-paper/5 max-w-md">
          <Img photo={{ src: 'lauren-minear-autumn-white-dress-1', name: 'Lauren Minear', alt: 'Lauren Minear in a white dress, sitting in fallen leaves at dusk and looking away' }} widths={WIDTHS.half} sizes="(min-width: 1024px) 30vw, 100vw" class="w-full h-full object-cover" />
        </div>
        <p class="mt-3 text-[10px] font-bold uppercase tracking-[0.2em] text-paper/50">Lauren Minear, one of the artists I work with across releases</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 order-1 lg:order-2 lg:sticky lg:top-28">
        <span class={`${label} text-mustard`}>{direction.numeral}. {direction.price}</span>
        <h2 class="font-sans font-black uppercase leading-[0.85] text-[clamp(3rem,7vw,6rem)] [font-stretch:62%]">{direction.title}</h2>
        <p class="mt-6 font-serif text-2xl leading-snug">{direction.forWhom}</p>
        <ul class="mt-8 border-t border-paper/25">
          {direction.includes.map((i) => <li class="py-3 border-b border-paper/15 text-base md:text-lg">{i}</li>)}
        </ul>
        <p class="mt-6 text-sm text-paper/70"><a href="/artist-development" class="underline underline-offset-4 hover:text-paper">How the four sessions and the monthly work run</a>.</p>
        <a href={`/contact?type=${direction.id}`} class="inline-block mt-10 text-xs font-bold uppercase tracking-[0.2em] px-8 py-5 bg-mustard text-ink hover:bg-paper transition-colors">{direction.cta}</a>
      </div>
    </div>
  </section>

  <!-- II. Album campaigns -->
  <section id={campaign.id} class="bg-mustard text-ink py-20 md:py-28 px-4 md:px-8 scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-6 lg:sticky lg:top-28">
        <span class={`${label} text-burgundy`}>{campaign.numeral}. {campaign.price}</span>
        <h2 class="font-sans font-black uppercase leading-[0.85] text-[clamp(3rem,7vw,6rem)] [font-stretch:62%]">{campaign.title}</h2>
        <p class="mt-6 font-serif text-2xl leading-snug">{campaign.forWhom}</p>
        <ul class="mt-8 border-t border-ink/25">
          {campaign.includes.map((i) => <li class="py-3 border-b border-ink/15 text-base md:text-lg">{i}</li>)}
        </ul>
        <p class="mt-6 text-sm text-ink/70">Rights are written into every agreement. <a href="/usage" class="underline underline-offset-4">How usage works</a>.</p>
        <a href={`/contact?type=${campaign.id}`} class="inline-block mt-10 text-xs font-bold uppercase tracking-[0.2em] px-8 py-5 bg-ink text-paper hover:bg-burgundy transition-colors">{campaign.cta}</a>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 grid grid-cols-2 gap-4">
        <a href="/work/the-devil-i-knew" class="group block">
          <Picture src={devilCover} alt="The Devil I Knew by Nicole Zuraitis, album cover" widths={[320, 640]} sizes="(min-width: 1024px) 20vw, 50vw" formats={['avif', 'webp']} class="w-full aspect-square object-cover shadow-[8px_8px_0_0_rgba(12,12,12,0.15)]" />
          <span class="block mt-3 font-serif italic text-lg leading-tight group-hover:underline">The Devil I Knew</span>
          <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-ink/60">Nicole Zuraitis · Album</span>
        </a>
        <a href="/work/til-the-world-ends" class="group block mt-12">
          <Picture src={laurenCover} alt="Til The World Ends by Lauren Minear, single artwork" widths={[320, 640]} sizes="(min-width: 1024px) 20vw, 50vw" formats={['avif', 'webp']} class="w-full aspect-square object-cover shadow-[8px_8px_0_0_rgba(12,12,12,0.15)]" />
          <span class="block mt-3 font-serif italic text-lg leading-tight group-hover:underline">Til The World Ends</span>
          <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-ink/60">Lauren Minear · Single</span>
        </a>
      </div>
    </div>
  </section>

  <!-- III. Release shoots -->
  <section id={shoot.id} class="bg-teal text-paper py-20 md:py-28 px-4 md:px-8 scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="aspect-[3/4] overflow-hidden bg-ink/10">
          <Img photo={IMAGES.serviceIdentity} widths={WIDTHS.half} sizes="(min-width: 1024px) 40vw, 100vw" class="w-full h-full object-cover" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 order-1 lg:order-2 lg:sticky lg:top-28">
        <span class={`${label} text-mustard`}>{shoot.numeral}. {shoot.price}</span>
        <h2 class="font-sans font-black uppercase leading-[0.85] text-[clamp(3rem,7vw,6rem)] [font-stretch:62%]">{shoot.title}</h2>
        <p class="mt-6 font-serif text-2xl leading-snug">{shoot.forWhom}</p>
        <ul class="mt-8 border-t border-paper/25">
          {shoot.includes.map((i) => <li class="py-3 border-b border-paper/15 text-base md:text-lg">{i}</li>)}
        </ul>
        <a href={`/contact?type=${shoot.id}`} class="inline-block mt-10 text-xs font-bold uppercase tracking-[0.2em] px-8 py-5 bg-paper text-teal hover:bg-mustard hover:text-ink transition-colors">{shoot.cta}</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-paper bg-grain text-ink py-20 md:py-28 px-4 md:px-8 scroll-mt-16" aria-labelledby="faq-title">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <h2 id="faq-title" class="lg:col-span-4 font-serif text-5xl md:text-6xl leading-[0.95] tracking-tight">Questions, <span class="italic">answered.</span></h2>
      <div class="lg:col-span-8 border-t-2 border-ink">
        {FAQ.map((f) => (
          <details class="group border-b border-ink/15 py-5">
            <summary class="flex items-start justify-between gap-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <h3 class="font-serif text-2xl md:text-3xl leading-snug">{f.q}</h3>
              <span class="shrink-0 mt-2 text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-ink/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- The ask -->
  <section class="bg-chocolate text-saffron py-20 md:py-28 px-4 md:px-8">
    <h2 class="font-serif text-5xl md:text-7xl leading-[0.92] tracking-tight max-w-4xl">Tell me what <span class="italic">you’re making.</span></h2>
    <p class="mt-6 text-paper/75 text-lg max-w-xl">Release shoots start at $2,500. Creative direction and album campaigns are quoted after a first call.</p>
    <a href="/contact" class="inline-block mt-10 text-xs font-bold uppercase tracking-[0.2em] px-8 py-5 bg-saffron text-chocolate hover:bg-paper transition-colors">Start a project</a>
  </section>
</Base>
