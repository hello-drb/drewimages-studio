---
// The one-page summary, laid out for US Letter and printed to /drewimages-studio.pdf
// (see the note at the bottom of this file). Built from the same data as the site, so it never
// says something the site doesn't. Not linked as a page and kept out of search.
import '../styles/global.css';
import Masthead from '../assets/brand/masthead.svg?raw';
import { OFFERS } from '../data/offers';
import { ARTIST_INDEX, BRAND_WORK } from '../data/artists';
import { PRESS_LOGOS, CONTACT } from '../data/content';

const BASE = 'https://res.cloudinary.com/diduw1fmf/image/upload';
const pic = (src: string) => `${BASE}/c_fill,g_auto,w_700,h_620,f_jpg,q_85/${src}`;
const PICS = ['v1768230325/jazzmeia_wide_ieefeg.png', 'v1768231551/katie_jacoby_dress_cxexe9.png', 'v1768541914/A7409419__2_1_onzvjc.jpg', 'v1768236231/isa_stitches_corkboard_s_bxgcqn.png'];
const artists = ARTIST_INDEX.filter((a) => a.line).slice(0, 5);
const alsoArtists = ARTIST_INDEX.filter((a) => !a.line).slice(0, 8).map((a) => a.name);
const serif = "font-family:'Newsreader Variable',Newsreader,Georgia,serif";
const display = "font-family:'Libre Caslon Condensed Variable','Libre Caslon Condensed',Georgia,serif";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>DrewImages — art direction and photography by Drew Bordeaux</title>
    <style is:inline>
      @page { size: 8.5in 11in; margin: 0; }
      html, body { margin: 0; background: #f3e6c8; }
      .sheet { width: 8.5in; height: 11in; padding: 0.45in 0.55in; box-sizing: border-box; overflow: hidden; background: #f3e6c8; color: #0c0c0c; display: flex; flex-direction: column; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
  </head>
  <body>
    <div class="sheet font-sans">
      <div class="w-[58%] text-chocolate [&>svg]:w-full [&>svg]:h-auto" set:html={Masthead} aria-hidden="true" />

      <div class="mt-5 grid grid-cols-12 gap-6 items-start">
        <h1 class="col-span-8 text-[25px] leading-[1.08] tracking-tight" style={display}>Art direction and photography for records, and the people who make them.</h1>
        <p class="col-span-4 text-[10.5px] leading-[1.5] text-right">Drew Bordeaux<br />{CONTACT.email}<br />drewimages.studio<br />New York and the Hudson Valley</p>
      </div>
      <p class="mt-3 text-[13px] leading-[1.45] max-w-[5.6in]" style={serif}>I direct and photograph releases for artists, and campaigns for the labels and brands around them. I write and produce records too, so every project starts with listening.</p>

      <div class="mt-4 grid grid-cols-4 gap-2">
        {PICS.map((p) => <img src={pic(p)} alt="" class="w-full aspect-[7/6.2] object-cover" />)}
      </div>
      <p class="mt-1.5 text-[8.5px] text-ink/60">Jazzmeia Horn · Katie Jacoby · Monifah · Isa Tailored &amp; Made</p>

      <div class="mt-5 grid grid-cols-12 gap-6">
        <div class="col-span-6">
          <h2 class="pb-1.5 border-b-2 border-ink text-[10px] font-semibold">Artists</h2>
          <ul>
            {artists.map((a) => (
              <li class="py-[5px] border-b border-ink/15 leading-tight">
                <span class="text-[14px]" style={display}>{a.name}</span>
                <span class="block text-[9.5px] text-ink/65">{a.line}</span>
              </li>
            ))}
          </ul>
          <p class="mt-2 text-[9.5px] leading-[1.5] text-ink/75">Also: {alsoArtists.join(', ')}.</p>
        </div>
        <div class="col-span-6">
          <h2 class="pb-1.5 border-b-2 border-ink text-[10px] font-semibold">Labels, ensembles and brands</h2>
          <ul>
            {BRAND_WORK.map((b) => (
              <li class="py-[5px] border-b border-ink/15 leading-tight">
                <span class="text-[14px]" style={display}>{b.name}</span>
                <span class="block text-[9.5px] text-ink/65">{b.role}</span>
              </li>
            ))}
          </ul>
          <p class="mt-2 text-[9.5px] leading-[1.5] text-ink/75">Releases on La Reserve Records and Empress Legacy Records. Pictures have run in {PRESS_LOGOS.map((l) => l.name).join(', ').replace(/, ([^,]*)$/, ' and $1')}.</p>
        </div>
      </div>

      <div class="mt-5">
        <h2 class="pb-1.5 border-b-2 border-ink text-[10px] font-semibold">Four ways to work</h2>
        <ol class="grid grid-cols-2 gap-x-6">
          {OFFERS.map((o) => (
            <li class="py-2 border-b border-ink/15">
              <span class="text-[15px] leading-tight" style={display}><span class="italic text-burgundy mr-1.5">{o.numeral}</span>{o.title}</span>
              <span class="block mt-1 text-[10.5px] leading-[1.4] text-ink/80" style={serif}>{o.summary}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-auto pt-4 flex items-end justify-between gap-6 border-t-2 border-ink">
        <p class="text-[11px] leading-[1.45] max-w-[4.6in]" style={serif}>A project goes in four steps: I listen to the music, plan the direction and the team, shoot, and deliver retouched files sized for every placement, with the usage in writing.</p>
        <p class="text-[10.5px] leading-[1.5] text-right shrink-0">Start a project<br /><span class="font-semibold">{CONTACT.email}</span><br />Recording Academy member</p>
      </div>
    </div>
  </body>
</html>
<!--
To remake the PDF after changing the site: build, serve dist/, then
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless --no-pdf-header-footer --print-to-pdf=public/drewimages-studio.pdf http://localhost:PORT/one-page.html
and build again so the new file ships.
-->
