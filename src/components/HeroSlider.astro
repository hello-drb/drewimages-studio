---
import Button from './Button.astro';
import Img from './Img.astro';
import { HERO_SLIDES } from '../data/content';
import { WIDTHS } from '../data/cloudinary';
---
<div class="relative w-full flex flex-col md:block bg-ink md:h-[95vh]" data-hero>
  <!-- Phone: 55vh, stacked above the text. Desktop: fills the hero. -->
  <div class="relative w-full h-[55vh] md:h-full overflow-hidden bg-ink transition-all duration-500 md:absolute md:inset-0">
    <div class="hidden md:block absolute top-0 left-0 w-full h-40 bg-gradient-to-b from-black/80 via-black/40 to-transparent z-20 pointer-events-none"></div>

    {HERO_SLIDES.map((slide, index) => (
      <div
        data-slide
        data-active={String(index === 0)}
        class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 data-[active=true]:opacity-100"
      >
        <Img
          photo={slide}
          widths={WIDTHS.hero}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          defer={index > 0}
          class="w-full h-full object-cover object-center md:object-[50%_25%] opacity-90 md:opacity-90"
        />
        <div class="hidden md:block absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink via-ink/40 to-transparent z-10"></div>
        <div class="md:hidden absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink to-transparent z-10"></div>
      </div>
    ))}

    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-1.5 z-30 md:hidden" aria-hidden="true">
      {HERO_SLIDES.map((_, idx) => (
        <div data-dot data-active={String(idx === 0)} class="h-0.5 transition-all duration-300 drop-shadow-md w-1.5 bg-white/40 data-[active=true]:w-4 data-[active=true]:bg-mustard"></div>
      ))}
    </div>
  </div>

  <!-- Phone: a block below the image. Desktop: overlaid on it. -->
  <div class="relative z-30 bg-ink px-6 py-10 md:bg-transparent md:absolute md:inset-0 md:flex md:flex-col md:justify-end md:pb-24 md:px-12 pointer-events-auto md:pointer-events-none">
    <div class="max-w-screen-2xl mx-auto w-full pointer-events-auto">
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-paper mb-6 leading-[0.95] md:leading-[0.9] tracking-tight max-w-4xl drop-shadow-none md:drop-shadow-lg text-balance">
        Creative direction <br />
        <span class="italic text-mustard">and photography.</span>
      </h1>

      <div class="flex flex-col md:flex-row items-start md:items-end justify-between w-full border-t border-white/20 pt-8 md:pt-8 mt-4">
        <p class="text-sm md:text-lg text-paper/90 max-w-lg font-light leading-relaxed mb-8 md:mb-0 md:drop-shadow-md text-balance">
          Art direction and photography for albums, artists and the brands around them.
          <span class="opacity-70 text-[10px] md:text-sm uppercase tracking-widest mt-2 block">New York–based. Available worldwide.</span>
        </p>

        <div class="grid grid-cols-2 md:flex gap-3 md:gap-4 w-full md:w-auto">
          <Button href="/contact" variant="burgundy" class="w-full md:w-auto px-4 md:px-6 text-sm md:text-lg">Start a project</Button>
          <Button href="/work" variant="outline" class="w-full md:w-auto px-4 md:px-6 text-sm md:text-lg text-paper border-paper hover:bg-paper hover:text-ink">See the work</Button>
        </div>
      </div>
    </div>

    <div class="hidden md:flex absolute bottom-8 right-12 gap-2 z-30 pointer-events-auto" aria-hidden="true">
      {HERO_SLIDES.map((_, idx) => (
        <div data-dot data-active={String(idx === 0)} class="h-1 transition-all duration-300 drop-shadow-md w-2 bg-white/40 data-[active=true]:w-8 data-[active=true]:bg-mustard"></div>
      ))}
    </div>
  </div>
</div>

<script>
  // Crossfade to the next slide every 4 seconds; the dots follow.
  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'));
    // Two rows of dots (phone and desktop), one dot per slide in each
    const dots = Array.from(hero.querySelectorAll<HTMLElement>('[data-dot]'));
    let current = 0;
    // Slides 2–8 start loading once the page (and the first slide) has finished
    const loadRest = () =>
      hero.querySelectorAll<HTMLImageElement>('img[data-srcset]').forEach((img) => {
        img.srcset = img.dataset.srcset!;
        img.src = img.dataset.src!;
      });
    if (document.readyState === 'complete') loadRest();
    else window.addEventListener('load', loadRest, { once: true });
    window.setInterval(() => {
      if (document.hidden) return;
      current = (current + 1) % slides.length;
      slides.forEach((s, i) => (s.dataset.active = String(i === current)));
      dots.forEach((d, i) => (d.dataset.active = String(i % slides.length === current)));
    }, 4000);
  }
</script>
