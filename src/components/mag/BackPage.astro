---
// The back of the book: where the pictures ran, the four ways to work (titles only), and the ask.
import { OFFERS } from '../../data/offers';
import { PRESS_LOGOS, CONTACT } from '../../data/content';
import { cld } from '../../data/cloudinary';
---
<!-- Where the pictures ran -->
<section class="bg-paper text-ink px-4 md:px-8 py-10 md:py-14 border-t border-ink/10">
  <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-14">
    <p class="shrink-0 text-sm text-ink/60">Where the pictures ran</p>
    <div class="flex flex-wrap items-center gap-x-10 gap-y-6 md:gap-x-16 opacity-70 mix-blend-multiply select-none">
      {PRESS_LOGOS.map((logo) => <img src={cld(logo.src, 400)} alt={logo.name} class="h-5 md:h-7 w-auto object-contain brightness-0" loading="lazy" decoding="async" />)}
    </div>
  </div>
</section>

<!-- The studio -->
<section id="studio" class="bg-chocolate text-paper px-4 md:px-8 py-20 md:py-28 scroll-mt-12" aria-labelledby="studio-title">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 id="studio-title" class="font-didone text-5xl md:text-7xl leading-[0.95] tracking-tight">Working together</h2>
      <p class="mt-6 max-w-sm font-text text-xl leading-relaxed text-paper/80">Four ways in, from a single shoot to a year of releases.</p>
      <p class="mt-8"><a href="/services" class="text-sm underline underline-offset-4 decoration-paper/40 hover:decoration-paper">How each one works</a></p>
    </div>
    <ol class="lg:col-span-8 border-t-2 border-saffron/70">
      {OFFERS.map((o) => (
        <li class="border-b border-paper/15">
          <a href={o.href ?? `/services#${o.id}`} class="group flex items-baseline gap-5 md:gap-8 py-6 md:py-8">
            <span class="font-didone italic text-3xl md:text-5xl leading-none text-saffron w-10 md:w-16 shrink-0">{o.numeral}</span>
            <span class="font-didone text-3xl md:text-5xl leading-[1.02] tracking-tight group-hover:text-saffron transition-colors">{o.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- The ask -->
<section class="bg-saffron text-chocolate px-4 md:px-8 py-24 md:py-36">
  <h2 class="font-didone text-6xl md:text-8xl lg:text-9xl leading-[0.9] tracking-tight max-w-5xl">Tell me what you’re making.</h2>
  <div class="mt-10 md:mt-14 flex flex-wrap items-center gap-x-8 gap-y-4">
    <a href="/contact" class="text-sm font-semibold px-8 py-5 bg-chocolate text-saffron hover:bg-ink transition-colors">Start a project</a>
    <a href={`mailto:${CONTACT.email}`} class="text-base underline underline-offset-4 decoration-chocolate/40 hover:decoration-chocolate">{CONTACT.email}</a>
  </div>
</section>
