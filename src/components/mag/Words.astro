---
// What clients say, kept from the live site: one long quote set large, two short ones, and the
// four portrait testimonials with the photographs they came from.
import Img from '../Img.astro';
import { HOME_TESTIMONIALS, WORK_CATEGORIES } from '../../data/content';
import { CASE_STUDIES } from '../../data/case-studies';

const sasha = WORK_CATEGORIES.find((c) => c.id === 'artists')!.testimonial!;
const liz = WORK_CATEGORIES.find((c) => c.id === 'founders')!.testimonial!;
const nicole = CASE_STUDIES.find((c) => c.slug === 'the-devil-i-knew')!.quote!;
const firstSentence = (q: string) => q.split('\n')[0];
const plainRole = (r?: string) => (r ?? '').replace(/ · /g, ', ');
---
<section class="bg-chocolate text-paper px-4 md:px-8 py-20 md:py-28" aria-labelledby="words-title">
  <h2 id="words-title" class="sr-only">What clients say</h2>

  <figure class="max-w-6xl">
    <blockquote class="font-didone text-[clamp(2.4rem,5.2vw,5.5rem)] leading-[1.02] tracking-tight text-balance">&ldquo;{firstSentence(sasha.quote)}&rdquo;</blockquote>
    <figcaption class="mt-7 text-sm md:text-base">
      <span class="font-semibold text-saffron">{sasha.author}</span>
      <span class="block mt-1 max-w-2xl text-paper/65">{plainRole(sasha.role)}</span>
    </figcaption>
  </figure>

  <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 border-t border-paper/20 pt-10 md:pt-12">
    <figure>
      <blockquote class="font-text text-2xl md:text-3xl leading-snug">&ldquo;{nicole.text}&rdquo;</blockquote>
      <figcaption class="mt-4 text-sm"><span class="font-semibold text-saffron">{nicole.author}</span> <span class="text-paper/65">Grammy Award–winning vocalist & composer</span></figcaption>
    </figure>
    <figure>
      <blockquote class="font-text text-2xl md:text-3xl leading-snug">&ldquo;{liz.quote.split('. ').slice(1, 2).join('. ')}.&rdquo;</blockquote>
      <figcaption class="mt-4 text-sm"><span class="font-semibold text-saffron">{liz.author}</span> <span class="text-paper/65">{plainRole(liz.role)}</span></figcaption>
    </figure>
  </div>

  <ul class="mt-16 md:mt-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-12">
    {HOME_TESTIMONIALS.map((t) => (
      <li>
        <figure>
          <div class="cursor-zoom-in" data-view data-view-name={t.author}>
            <Img photo={t.photo} widths={[400, 700, 1000, 1600]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="w-full aspect-[3/2] object-cover" />
          </div>
          <blockquote class="mt-5 font-text text-xl leading-snug">&ldquo;{t.quote.replace(/ — /g, ': ')}&rdquo;</blockquote>
          <figcaption class="mt-3 text-sm font-semibold text-saffron">{t.author}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>
