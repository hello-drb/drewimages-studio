---
// A case study as a magazine feature, pictures first: an opening spread with the artwork and a
// standfirst, full-bleed photographs, a sliding strip of more work, then one paragraph of story
// (the rest opens on request) and liner-note credits. Same data and structured data as the older CaseStudy layout.
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Strip, { type StripItem } from './Strip.astro';
import type { CaseStudy } from '../../data/case-studies';
import { publishedCaseStudies } from '../../data/case-studies';
import { CLOUD_SIZES } from '../../data/issue';
import { SITE, DREW_ID, STUDIO_ID, breadcrumbs } from '../../data/schema';
import { cld, srcset } from '../../data/cloudinary';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const url = `${SITE}/work/${study.slug}`;
const coverAbsolute = study.cover ? new URL((await getImage({ src: study.cover.src, width: 1200, format: 'jpg' })).src, SITE).href : undefined;
const next = publishedCaseStudies().find((c) => c.slug !== study.slug);

const creativeWork = {
  '@type': 'CreativeWork',
  '@id': `${url}#work`,
  name: `${study.release}: ${study.role.toLowerCase()}`,
  url,
  about: {
    '@type': study.format === 'Single' ? 'MusicRecording' : 'MusicAlbum',
    name: study.release,
    byArtist: { '@type': 'Person', name: study.artist },
    ...(study.releaseDate ? { datePublished: study.releaseDate } : {}),
  },
  ...(coverAbsolute ? { image: coverAbsolute } : {}),
  dateCreated: study.shot.when.match(/\d{4}/)?.[0],
  locationCreated: study.shot.where.map((name) => ({ '@type': 'Place', name })),
  creator: { '@type': 'Role', roleName: study.credits.find((c) => c.isDrew)?.role, creator: { '@id': DREW_ID } },
  contributor: study.credits
    .filter((c) => !c.isDrew)
    .map((c) => ({ '@type': 'Role', roleName: c.role, contributor: { '@type': c.type ?? 'Person', name: c.name } })),
  provider: { '@id': STUDIO_ID },
};

const [lead, second, third, ...rest] = study.images;
const WIDE = [800, 1280, 1920, 2560];
const HALF = [600, 900, 1400];
const more: StripItem[] = (study.more?.images ?? []).map((p) => {
  const [w, h] = CLOUD_SIZES[p.src] ?? [3, 2];
  return { cloud: p.src, w, h, alt: p.alt, name: p.name ?? study.artist };
});
const [firstPara, ...otherParas] = study.body;
const label = 'font-grotesk text-[10px] md:text-xs font-bold uppercase tracking-[0.28em]';
---
<Base
  title={study.metaTitle}
  description={study.metaDescription}
  ogImage={study.cover ? `${SITE}/og/${study.slug}.jpg` : undefined}
  ogImageAlt={study.cover?.alt}
  noindex={!study.published}
  schema={[creativeWork, breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work' }, { name: study.release, path: `/work/${study.slug}` }])]}
>
  <article class="bg-paper text-ink">
    <!-- Opening spread -->
    <header class="px-4 md:px-8 pt-28 md:pt-36 pb-14 md:pb-20">
      <p class={`${label} flex items-center gap-4 pb-4 border-b-[3px] border-ink`}>
        <span>Feature</span><span class="text-ink/40">No. {study.number}</span><span class="ml-auto text-ink/50">{study.format}, {study.year}</span>
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end mt-10 md:mt-14">
        <div class="lg:col-span-7">
          <p class={`${label} text-burgundy`}>{study.artist}</p>
          <h1 class="mt-4 font-didone italic leading-[0.88] tracking-tight text-[clamp(3.75rem,11vw,10.5rem)] text-balance">{study.release}</h1>
          <p class="mt-8 md:mt-10 font-didone text-2xl md:text-[2rem] leading-[1.22] max-w-2xl">{study.dek}</p>
          <p class={`${label} mt-8 text-ink/60`}>{study.role} by Drew Bordeaux</p>
        </div>
        {study.cover && (
          <figure class="lg:col-span-5">
            <Picture
              src={study.cover.src}
              alt={study.cover.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              formats={['avif', 'webp']}
              loading="eager"
              class="w-full aspect-square object-cover shadow-[0_30px_60px_-30px_rgba(12,12,12,0.6)]"
              style={`view-transition-name: art-${study.slug};`}
            />
            {study.coverCaption && <figcaption class={`${label} mt-4 text-ink/50`}>{study.coverCaption}</figcaption>}
          </figure>
        )}
      </div>
    </header>

    <!-- The lead photograph, full bleed -->
    {lead && (
      <figure>
        <img src={cld(lead.src, 1920)} srcset={srcset(lead.src, WIDE)} sizes="100vw" alt={lead.alt} class="w-full max-h-[92vh] object-cover [view-transition-name:cover-story]" decoding="async" />
      </figure>
    )}

    <!-- A pair -->
    {second && third && (
      <div class="px-4 md:px-8 py-3 md:py-5 grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-5">
        {[second, third].map((p) => (
          <figure>
            <img src={cld(p.src, 1400)} srcset={srcset(p.src, HALF)} sizes="(min-width: 768px) 50vw, 100vw" alt={p.alt} class="w-full aspect-[3/2] object-cover" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    )}

    {rest.map((p) => (
      <figure>
        <img src={cld(p.src, 1920)} srcset={srcset(p.src, WIDE)} sizes="100vw" alt={p.alt} class="w-full max-h-[92vh] object-cover" loading="lazy" decoding="async" />
      </figure>
    ))}

    <!-- More with the same artist, sliding -->
    {more.length > 0 && (
      <section class="bg-ink text-paper pt-16 md:pt-24 pb-14 md:pb-20 overflow-hidden" aria-labelledby="more-title">
        <div class="px-4 md:px-8 flex items-end justify-between gap-6 mb-8 md:mb-12">
          <h2 id="more-title" class="font-didone italic text-5xl md:text-7xl leading-[0.92] tracking-tight">{study.more!.title}</h2>
          <div class="flex items-center gap-3">
            <span class={`${label} hidden sm:block text-paper/60 tabular-nums`} data-strip-count></span>
            <button type="button" class="w-11 h-11 border border-paper/30 hover:bg-paper hover:text-ink transition-colors" data-strip-prev aria-label="Previous picture">&larr;</button>
            <button type="button" class="w-11 h-11 border border-paper/30 hover:bg-paper hover:text-ink transition-colors" data-strip-next aria-label="Next picture">&rarr;</button>
          </div>
        </div>
        <Strip items={more} label={study.more!.title} />
      </section>
    )}

    <!-- The story: one paragraph, the rest behind a button -->
    <div class="px-4 md:px-8 py-16 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <aside class="lg:col-span-3 order-2 lg:order-1">
        <dl class="border-t-[3px] border-ink">
          <div class="py-4 border-b border-ink/15">
            <dt class={`${label} text-ink/45 mb-1`}>Made</dt>
            <dd class="font-didone text-lg leading-snug">{study.madeList.join(' · ')}</dd>
          </div>
          <div class="py-4 border-b border-ink/15">
            <dt class={`${label} text-ink/45 mb-1`}>Shot</dt>
            <dd class="font-didone text-lg leading-snug">{study.shot.when}<br />{study.shot.where.join(' · ')}</dd>
          </div>
        </dl>
      </aside>
      <div class="lg:col-span-8 lg:col-start-5 order-1 lg:order-2">
        <p class="feature-lede text-lg md:text-xl leading-[1.75] text-ink/90 max-w-[42rem]">{firstPara}</p>
        {otherParas.length > 0 && (
          <details class="group mt-8 max-w-[42rem]">
            <summary class="inline-flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden font-grotesk text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 hover:text-burgundy">
              <span class="group-open:hidden">Read the story</span><span class="hidden group-open:inline">Close the story</span>
              <span class="transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="mt-8 space-y-6 text-lg md:text-xl leading-[1.75] text-ink/85">
              {otherParas.map((p) => <p>{p}</p>)}
            </div>
          </details>
        )}
      </div>
    </div>

    {study.quote?.approved && (
      <figure class="bg-saffron text-chocolate px-4 md:px-8 py-20 md:py-32">
        <blockquote class="font-didone leading-[1.04] tracking-tight text-[clamp(2.2rem,5vw,5rem)] max-w-6xl text-balance">&ldquo;{study.quote.text}&rdquo;</blockquote>
        <figcaption class={`${label} mt-8`}>{study.quote.author}</figcaption>
      </figure>
    )}

    <!-- Liner notes -->
    <div class="px-4 md:px-8 py-16 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <h2 class={`${label} lg:col-span-3 text-ink/50`}>Liner notes</h2>
      <dl class="lg:col-span-9 grid grid-cols-1 md:grid-cols-2 gap-x-16 border-t-[3px] border-ink">
        {study.credits.map((c) => (
          <div class="py-5 border-b border-ink/10">
            <dt class={`${label} text-ink/40 mb-1`}>{c.role}</dt>
            <dd class={`font-didone text-2xl ${c.isDrew ? 'text-burgundy' : ''}`}>{c.name}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Next -->
    <div class="bg-chocolate text-paper px-4 md:px-8 py-20 md:py-28 grid grid-cols-1 lg:grid-cols-2 gap-14">
      {next && (
        <a href={`/work/${next.slug}`} class="group block">
          <span class={`${label} text-saffron`}>Next feature</span>
          <span class="block mt-4 font-didone italic text-5xl md:text-7xl leading-[0.92] group-hover:text-saffron transition-colors">{next.release}</span>
          <span class={`${label} block mt-4 text-paper/60`}>{next.artist} &rarr;</span>
        </a>
      )}
      <div class="lg:border-l lg:border-paper/20 lg:pl-14">
        <span class={`${label} text-saffron`}>Making a record?</span>
        <p class="mt-4 font-didone text-3xl md:text-4xl leading-tight max-w-md">Tell me what you’re making and when it comes out.</p>
        <a href="/contact" class="inline-block mt-8 font-grotesk text-xs font-bold uppercase tracking-[0.2em] px-8 py-5 bg-saffron text-chocolate hover:bg-paper transition-colors">Start a project</a>
      </div>
    </div>
  </article>
</Base>

<style>
  /* Drop cap on the first paragraph, the way a feature opens */
  .feature-lede::first-letter {
    float: left;
    font-family: 'Bodoni Moda Variable', 'Bodoni Moda', serif;
    font-size: 5.6em;
    line-height: 0.74;
    padding: 0.08em 0.1em 0 0;
    color: #661822;
  }
</style>
