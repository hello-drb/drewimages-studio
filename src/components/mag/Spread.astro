---
// A feature as a two-page spread: the record's artwork on one page, a pull line on the other,
// with a gutter between them. The artwork carries into the feature page when it's clicked.
import { Picture } from 'astro:assets';
import type { CaseStudy } from '../../data/case-studies';

interface Props {
  study: CaseStudy;
  /** The line set large. Drew's own words go without quotation marks; a client's go with them. */
  line?: string;
  /** Who said it, when it's a quote. */
  attribution?: string;
  /** Which page the artwork sits on. */
  art?: 'left' | 'right';
  tone?: 'paper' | 'mustard';
}

const { study, line, attribution, art = 'right', tone = 'paper' } = Astro.props;
const bg = tone === 'mustard' ? 'bg-saffron text-chocolate' : 'bg-paper text-ink';
const rule = tone === 'mustard' ? 'border-chocolate/25' : 'border-ink/15';
---
<section class={`${bg} px-4 md:px-8 py-16 md:py-0`} aria-label={`Feature: ${study.release}`}>
  <a href={`/work/${study.slug}`} class="group grid grid-cols-1 md:grid-cols-2 md:min-h-[88vh]">
    <div class={`flex flex-col justify-center py-2 md:py-24 ${art === 'right' ? `md:pr-12 lg:pr-20 md:border-r ${rule}` : `md:pl-12 lg:pl-20 md:order-2`}`}>
      <span class="font-grotesk text-[10px] md:text-xs font-bold uppercase tracking-[0.28em] opacity-60">Feature <span class="mx-1">·</span> {study.artist} <span class="mx-1">·</span> {study.format}, {study.year}</span>
      {line ? (
        <p class={`mt-6 md:mt-8 font-didone leading-[1.02] tracking-tight text-balance text-[clamp(2.2rem,4.4vw,4.5rem)] ${attribution ? '' : 'italic'}`}>
          {attribution ? <>&ldquo;{line}&rdquo;</> : line}
        </p>
      ) : (
        <p class="mt-6 md:mt-8 font-didone italic leading-[0.9] tracking-tight text-balance text-[clamp(3.5rem,8vw,8.5rem)]">{study.release}</p>
      )}
      {attribution && <span class="mt-5 font-grotesk text-[10px] md:text-xs font-bold uppercase tracking-[0.25em] opacity-70">{attribution}</span>}
      <span class="mt-8 md:mt-12 flex items-baseline gap-4 flex-wrap">
        {line && <span class="font-grotesk font-black uppercase leading-none [font-stretch:62%] text-3xl md:text-5xl">{study.release}</span>}
        <span class="font-grotesk text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 group-hover:opacity-60">{study.role} &rarr;</span>
      </span>
    </div>
    <div class={`flex items-center justify-center mt-10 md:mt-0 md:py-20 ${art === 'right' ? 'md:pl-12 lg:pl-20' : `md:pr-12 lg:pr-20 md:order-1 md:border-r ${rule}`}`}>
      {study.cover && (
        <Picture
          src={study.cover.src}
          alt={study.cover.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 42vw, 100vw"
          formats={['avif', 'webp']}
          class="w-full max-w-[36rem] aspect-square object-cover shadow-[0_30px_60px_-30px_rgba(12,12,12,0.6)] transition-transform duration-700 ease-out group-hover:-translate-y-1"
          style={`view-transition-name: art-${study.slug};`}
        />
      )}
    </div>
  </a>
</section>
