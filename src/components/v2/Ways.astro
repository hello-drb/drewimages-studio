---
// Three ways to work, on the NOIR pairing (turquoise on maroon). Plain names, up-market terms.
import { OFFERS } from '../../data/offers';
---
<section class="bg-maroon text-turquoise py-20 md:py-28 px-4 md:px-8" aria-labelledby="ways-title">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
    <h2 id="ways-title" class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[0.92] tracking-tight">Three ways <span class="italic">to work.</span></h2>
    <a href="/services" class="text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 self-start md:self-auto hover:opacity-80">How each one works &rarr;</a>
  </div>
  <ol class="grid grid-cols-1 md:grid-cols-3 border-t-2 border-turquoise/60">
    {OFFERS.map((w, i) => (
      <li class={`py-8 md:py-10 md:px-8 first:md:pl-0 last:md:pr-0 border-b md:border-b-0 border-turquoise/30 flex flex-col ${i > 0 ? 'md:border-l' : ''}`}>
        <span class="block font-serif italic text-6xl md:text-7xl leading-none mb-6">{w.numeral}</span>
        <h3 class="font-sans font-black uppercase text-3xl md:text-4xl leading-none [font-stretch:62%] mb-4 text-paper">{w.title}</h3>
        <p class="text-base md:text-lg leading-relaxed text-paper/80 max-w-sm mb-6">{w.summary}</p>
        <p class="mt-auto text-xs font-bold uppercase tracking-[0.2em]">{w.price}</p>
      </li>
    ))}
  </ol>
</section>
