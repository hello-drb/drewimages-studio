---
// "In this issue": the case studies, each as a feature with its cover.
import { Picture } from 'astro:assets';
import { publishedCaseStudies } from '../../data/case-studies';

const studies = publishedCaseStudies();
---
<section class="bg-paper text-ink py-20 md:py-28 px-4 md:px-8" aria-labelledby="features-title">
  <div class="flex items-end justify-between gap-6 mb-10 md:mb-14">
    <h2 id="features-title" class="font-sans font-black uppercase leading-[0.85] text-[clamp(3rem,8vw,7rem)] [font-stretch:62%]">In this <span class="font-serif normal-case italic font-normal [font-stretch:100%]">issue</span></h2>
    <a href="/work" class="shrink-0 text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-current pb-1 hover:text-burgundy">All the work &rarr;</a>
  </div>
  <div class="border-t-[3px] border-ink"></div>
  <div class="mt-[3px] border-t border-ink mb-10 md:mb-14"></div>

  <ul class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-10 lg:gap-16">
    {studies.map((s) => (
      <li>
        <a href={`/work/${s.slug}`} class="group block">
          {s.cover && (
            <Picture
              src={s.cover.src}
              alt={s.cover.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 46vw, 100vw"
              formats={['avif', 'webp']}
              class="w-full aspect-square object-cover shadow-[10px_10px_0_0_rgba(12,12,12,0.12)] group-hover:shadow-none group-hover:translate-x-[2px] group-hover:translate-y-[2px] transition-all duration-300"
            />
          )}
          <span class="block mt-6 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] text-teal">No. {s.number} · {s.artist} · {s.format}, {s.year}</span>
          <span class="block mt-2 font-serif italic text-4xl md:text-5xl lg:text-6xl leading-[0.95] text-burgundy">{s.release}</span>
          <span class="block mt-4 font-serif text-lg md:text-xl leading-snug text-ink/80 max-w-xl">{s.dek}</span>
          <span class="block mt-4 text-xs font-bold uppercase tracking-[0.2em] text-ink/60 group-hover:text-teal transition-colors">{s.role} &rarr;</span>
        </a>
      </li>
    ))}
  </ul>
</section>
