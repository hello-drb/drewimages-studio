---
// A Cloudinary image with f_auto,q_auto, responsive widths and its written alt text.
import { cld, srcset, WIDTHS } from '../data/cloudinary';
import type { Photo } from '../data/content';

interface Props {
  photo: Photo;
  sizes: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  draggable?: 'true' | 'false';
  /** Leave src/srcset in data attributes for a script to fill in later (hero slides 2–8). */
  defer?: boolean;
}

const { photo, sizes, widths = WIDTHS.tile, class: className, loading = 'lazy', fetchpriority, draggable, defer = false } = Astro.props;
const fallback = widths[Math.min(2, widths.length - 1)];
const src = cld(photo.src, fallback);
const set = srcset(photo.src, widths);
---
<img
  src={defer ? undefined : src}
  srcset={defer ? undefined : set}
  data-src={defer ? src : undefined}
  data-srcset={defer ? set : undefined}
  sizes={sizes}
  alt={photo.alt}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  draggable={draggable}
/>
