---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'burgundy' | 'teal';
  type?: 'submit' | 'button';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', type = 'button', class: className = '', ...rest } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center px-6 py-4 font-sans text-xs font-bold uppercase tracking-[0.2em] transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-current border-2';

const variants = {
  primary: 'bg-burgundy text-paper border-burgundy hover:bg-paper hover:text-burgundy',
  secondary: 'bg-teal text-paper border-teal hover:bg-paper hover:text-teal',
  outline: 'bg-transparent text-ink border-ink hover:bg-ink hover:text-paper',
  burgundy: 'bg-burgundy text-paper border-white/20 hover:bg-burgundy/90',
  teal: 'bg-teal text-paper border-white/20 hover:bg-teal/90',
};

const classes = `${baseStyles} ${variants[variant]} ${className}`;
---
{href ? (
  <a href={href} class={classes} {...rest}><slot /></a>
) : (
  <button type={type} class={classes} {...rest}><slot /></button>
)}
