---
// Fixed header. On the home page it sits transparent over the hero until the page scrolls.
// data-state is "transparent", "solid" or "menu" (phone menu open, or fading out); data-open tracks the phone menu.
import { NAV_LINKS, LOGO } from '../data/content';
import { cld } from '../data/cloudinary';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
---
<header
  id="site-header"
  data-home={String(isHome)}
  data-state={isHome ? 'transparent' : 'solid'}
  data-open="false"
  class="group/header fixed top-0 left-0 w-full z-50 transition-all duration-500
    data-[state=menu]:bg-[#F3E6C8] data-[state=menu]:transition-colors data-[state=menu]:duration-300
    data-[state=transparent]:bg-transparent data-[state=transparent]:border-transparent data-[state=transparent]:py-4 md:data-[state=transparent]:py-6
    data-[state=solid]:bg-paper/95 data-[state=solid]:backdrop-blur-md data-[state=solid]:border-b data-[state=solid]:border-ink/10 data-[state=solid]:shadow-sm data-[state=solid]:py-3"
>
  <!-- Phone gradient for legibility over the hero, only while transparent -->
  <div class={`md:hidden absolute inset-0 h-24 -z-10 pointer-events-none bg-gradient-to-b from-black/80 via-black/40 to-transparent opacity-0 group-data-[state=transparent]/header:opacity-100 transition-opacity duration-300`}></div>

  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-12 md:h-16 relative z-50">
    <a href="/" class="relative group block shrink-0 z-50" data-menu-close>
      <img
        src={cld(LOGO, 400)}
        srcset={`${cld(LOGO, 200)} 200w, ${cld(LOGO, 400)} 400w, ${cld(LOGO, 600)} 600w`}
        sizes="(min-width: 768px) 220px, 130px"
        alt="DrewImages Studio"
        class={`h-8 md:h-14 w-auto object-contain transition-all duration-300 group-hover:opacity-80 opacity-100 group-data-[state=transparent]/header:invert group-data-[state=transparent]/header:brightness-0`}
      />
    </a>

    <nav class="hidden md:flex items-center space-x-8" aria-label="Main">
      {NAV_LINKS.map((link) => (
        <a
          href={link.path}
          aria-current={path === link.path ? 'page' : undefined}
          class={`text-xs font-bold uppercase tracking-widest transition-colors relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-px after:bg-current after:transition-all hover:after:w-full ${path === link.path ? 'after:w-full' : ''} text-ink hover:text-burgundy group-data-[state=transparent]/header:text-paper group-data-[state=transparent]/header:hover:text-white`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class={`ml-4 text-xs font-bold uppercase tracking-widest px-6 py-3 transition-colors shadow-sm bg-ink text-paper hover:bg-burgundy group-data-[state=transparent]/header:bg-paper group-data-[state=transparent]/header:text-ink group-data-[state=transparent]/header:hover:bg-white`}>
        Inquire
      </a>
    </nav>

    <div class="flex md:hidden items-center gap-3 z-50">
      <a
        href="/contact"
        class={`group-data-[open=true]/header:hidden text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border rounded-full transition-colors text-ink border-ink/20 group-data-[state=transparent]/header:text-paper group-data-[state=transparent]/header:border-paper/40`}
      >
        Inquire
      </a>
      <button
        type="button"
        id="menu-toggle"
        class={`p-1 focus:outline-none text-ink group-data-[state=transparent]/header:text-paper`}
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="w-6 h-4 flex flex-col justify-between items-end">
          <span class="w-full h-0.5 bg-current transition-transform duration-300 origin-right group-data-[open=true]/header:-rotate-45 group-data-[open=true]/header:-translate-y-[1px] group-data-[open=true]/header:-translate-x-[1px]"></span>
          <span class="w-3/4 h-0.5 bg-current transition-opacity duration-300 group-data-[open=true]/header:opacity-0"></span>
          <span class="w-full h-0.5 bg-current transition-transform duration-300 origin-right group-data-[open=true]/header:rotate-45 group-data-[open=true]/header:-translate-y-[1px] group-data-[open=true]/header:-translate-x-[1px]"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Phone menu: the curtain fades over 500ms while the links fade on their own timing -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[#F3E6C8] z-40 flex flex-col pt-24 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden
      opacity-0 invisible pointer-events-none
      group-data-[open=true]/header:opacity-100 group-data-[open=true]/header:visible group-data-[open=true]/header:pointer-events-auto"
  >
    <div class="flex-grow flex flex-col items-center justify-center space-y-8 p-6 transition-all duration-300 opacity-0 translate-y-4 delay-0 group-data-[open=true]/header:opacity-100 group-data-[open=true]/header:translate-y-0 group-data-[open=true]/header:delay-100">
      {NAV_LINKS.map((link) => (
        <a href={link.path} data-menu-close class="font-serif text-5xl text-ink italic hover:text-burgundy transition-colors">
          {link.label}
        </a>
      ))}
      <div class="w-12 h-px bg-ink/10 my-8"></div>
      <a href="/contact" data-menu-close class="font-sans font-bold text-xs uppercase tracking-widest bg-ink text-paper px-10 py-4 shadow-lg active:scale-95 transition-transform">
        Inquire About Project
      </a>
    </div>
    <div class="p-8 text-center border-t border-ink/5 transition-opacity duration-300 opacity-0 group-data-[open=true]/header:opacity-100 group-data-[open=true]/header:delay-200">
      <p class="text-[10px] font-bold uppercase tracking-widest text-ink/30">NYC — Worldwide</p>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const isHome = header.dataset.home === 'true';
  let open = false;
  let closing = false;
  let timer: number | undefined;

  function update() {
    const scrolled = window.scrollY > 20;
    header.dataset.state = open || closing ? 'menu' : isHome && !scrolled ? 'transparent' : 'solid';
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  function close() {
    if (!open) return;
    open = false;
    // Keep the solid cream header until the curtain has finished fading (500ms)
    closing = true;
    update();
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      closing = false;
      update();
    }, 500);
  }

  toggle.addEventListener('click', () => {
    if (open) {
      close();
    } else {
      open = true;
      update();
    }
  });
  header.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  window.addEventListener('scroll', update, { passive: true });
  // Closing the menu on back/forward (pages restored from the back-forward cache)
  window.addEventListener('pageshow', () => {
    open = false;
    closing = false;
    update();
  });
  update();
</script>
